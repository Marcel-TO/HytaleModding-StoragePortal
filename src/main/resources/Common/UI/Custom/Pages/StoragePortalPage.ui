$C = "../Common.ui";

// Only the two panels have backgrounds; the world remains visible between them.
Group #PortalDisplays {
  Anchor: (Full: 0);
  LayoutMode: CenterMiddle;

  Group #PanelRow {
    Anchor: (Width: 1584, Height: 720);
    LayoutMode: Left;

    $C.@DecoratedContainer #InventoryPanel {
      Anchor: (Width: 744, Height: 680);

      #Title {
        Group {
          LayoutMode: Left;

          $C.@Title {
            @Text = "Your inventory";
          }
        }
      }

      #Content {
        LayoutMode: Top;

        Group #InventoryScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Top: 6, Left: 8, Right: 8);

          Group #InventoryGrid {
            Anchor: (Width: 648);
            LayoutMode: LeftCenterWrap;
          }
        }

        Group #InventorySeparator {
          Anchor: (Height: 2);
          Background: #19252F;
        }

        Label #HotbarTitle {
          Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          Anchor: (Height: 28);
          Padding: (Left: 8);
          Text: "Hotbar";
        }

        Group #HotbarScroll {
          Anchor: (Height: 78);
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Top: 6, Left: 8, Right: 8);

          Group #HotbarGrid {
            Anchor: (Width: 648);
            LayoutMode: LeftCenterWrap;
          }
        }
      }
    }

    Group #PanelGap {
      Anchor: (Width: 96);
    }

    $C.@DecoratedContainer #StoragePanel {
      Anchor: (Width: 744, Height: 720);

      #Title {
        Group {
          LayoutMode: Left;

          $C.@Title {
            @Text = "Storage Portal";
          }
        }

        $C.@HeaderSearch {}
      }

      #Content {
        LayoutMode: Top;

        Group #InfoRow {
          Anchor: (Height: 44);
          LayoutMode: Left;
          Padding: (Left: 8, Right: 8);

          Label #ContainerInfo {
            Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
            FlexWeight: 1;
            Text: "";
          }

          $C.@SecondaryTextButton #QuickStackButton {
            @Anchor = (Width: 190);
            Text: "Quick stack";
          }
        }

        Group #StorageScroll {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Top: 6, Left: 8, Right: 8);

          Group #StorageGrid {
            Anchor: (Width: 648);
            LayoutMode: LeftCenterWrap;
          }
        }

        Label #StatusLabel {
          Anchor: (Height: 46);
          Padding: (Left: 8, Right: 8);
          Style: (
            FontSize: 14,
            TextColor: #7caacc,
            HorizontalAlignment: Center,
            VerticalAlignment: Center,
            Wrap: true,
          );
          Text: "";
        }
      }
    }
  }
}

$C.@BackButton {}

Group #ItemSelectionOverlay {
  Anchor: (Full: 0);
  LayoutMode: Full;
  Visible: false;

  Button #SelectionDismissArea {
    Anchor: (Full: 0);
    Style: (
      Default: (Background: #000000(0.45)),
      Hovered: (Background: #000000(0.45)),
      Pressed: (Background: #000000(0.45)),
    );
  }

  Group {
    Anchor: (Full: 0);
    LayoutMode: CenterMiddle;

    Group #SelectionPanel {
      Anchor: (Width: 320, Height: 308);
      LayoutMode: Top;
      Background: #1a2530;
      Padding: 16;

      Label #SelectionTitle {
        Anchor: (Height: 44);
        Style: (
          ...$C.@DefaultLabelStyle,
          RenderBold: true,
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        );
        Text: "";
      }

      Label #SelectionDirection {
        Anchor: (Height: 28);
        Style: (
          FontSize: 14,
          TextColor: #7caacc,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        );
        Text: "";
      }

      $C.@SecondaryTextButton #SelectionOne {
        @Anchor = (Height: 40);
        Text: "One item";
      }

      $C.@SecondaryTextButton #SelectionHalfStack {
        @Anchor = (Height: 40);
        Text: "Half a stack";
      }

      $C.@SecondaryTextButton #SelectionStack {
        @Anchor = (Height: 40);
        Text: "One stack";
      }

      $C.@SecondaryTextButton #SelectionHighlight {
        @Anchor = (Height: 40);
        Text: "Highlight";
        Disabled: true;
        TooltipText: "Not implemented yet";
      }

      $C.@SecondaryTextButton #SelectionCloseButton {
        @Anchor = (Height: 40);
        Text: "Cancel";
      }
    }
  }
}
