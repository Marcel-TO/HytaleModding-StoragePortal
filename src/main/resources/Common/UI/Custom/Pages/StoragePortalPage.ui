$C = "../Common.ui";

$C.@PageOverlay {}

// Height leaves room for the title bar and the decorations on a 1280x720 viewport.
$C.@DecoratedContainer {
  Anchor: (Width: 800, Height: 660);

  #Title {
    Group {
      LayoutMode: Left;

      $C.@Title {
        @Text = "Storage Portal";
      }
    }

    $C.@HeaderSearch {}
  }

  #Content {
    LayoutMode: Top;

    // Summary of the containers in range, and the quick stack action
    Group #InfoRow {
      Anchor: (Height: 44);
      LayoutMode: Left;

      Label #ContainerInfo {
        Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
        Padding: (Left: 8);
        FlexWeight: 1;
        Text: "";
      }

      $C.@SecondaryTextButton #QuickStackButton {
        @Anchor = (Width: 190);
        Text: "Quick stack";
      }
    }

    // Items of the containers around the portal
    Group #StorageScroll {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Top: 6, Left: 8, Right: 8);

      Group #StorageGrid {
        LayoutMode: LeftCenterWrap;
      }
    }

    Group #Separator {
      Anchor: (Height: 2);
      Background: #19252F;
    }

    Label #InventoryTitle {
      Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
      Anchor: (Height: 24);
      Padding: (Left: 8);
      Text: "Your inventory";
    }

    // Items the player carries
    Group #InventoryScroll {
      Anchor: (Height: 156);
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Top: 6, Left: 8, Right: 8);

      Group #InventoryGrid {
        LayoutMode: LeftCenterWrap;
      }
    }

    Label #StatusLabel {
      Anchor: (Height: 26);
      Style: (
        FontSize: 14,
        TextColor: #7caacc,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
      );
      Text: "";
    }
  }
}

$C.@BackButton {}

Group #ItemSelectionOverlay {
  Anchor: (Full: 0);
  LayoutMode: Full;
  Visible: false;

  Button #SelectionDismissArea {
    Anchor: (Full: 0);
    Style: (
      Default: (Background: #000000(0.45)),
      Hovered: (Background: #000000(0.45)),
      Pressed: (Background: #000000(0.45)),
    );
  }

  Group {
    Anchor: (Full: 0);
    LayoutMode: CenterMiddle;

    Group #SelectionPanel {
      Anchor: (Width: 320, Height: 308);
      LayoutMode: Top;
      Background: #1a2530;
      Padding: 16;

      Label #SelectionTitle {
        Anchor: (Height: 44);
        Style: (
          ...$C.@DefaultLabelStyle,
          RenderBold: true,
          Wrap: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        );
        Text: "";
      }

      Label #SelectionDirection {
        Anchor: (Height: 28);
        Style: (
          FontSize: 14,
          TextColor: #7caacc,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
        );
        Text: "";
      }

      $C.@SecondaryTextButton #SelectionOne {
        @Anchor = (Height: 40);
        Text: "One item";
      }

      $C.@SecondaryTextButton #SelectionHalfStack {
        @Anchor = (Height: 40);
        Text: "Half a stack";
      }

      $C.@SecondaryTextButton #SelectionStack {
        @Anchor = (Height: 40);
        Text: "One stack";
      }

      $C.@SecondaryTextButton #SelectionHighlight {
        @Anchor = (Height: 40);
        Text: "Highlight";
        Disabled: true;
        TooltipText: "Not implemented yet";
      }

      $C.@SecondaryTextButton #SelectionCloseButton {
        @Anchor = (Height: 40);
        Text: "Cancel";
      }
    }
  }
}
